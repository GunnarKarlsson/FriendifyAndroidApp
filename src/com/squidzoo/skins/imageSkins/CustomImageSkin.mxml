<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:mx="library://ns.adobe.com/flex/mx"
		xmlns:s="library://ns.adobe.com/flex/spark"
		width="100%" height="100%">
	<!-- host component -->
	<fx:Metadata>
		[HostComponent("spark.components.Image")]
	</fx:Metadata>
	
	<!-- states -->
	<s:states>
		<s:State name="disabled" />
		<s:State name="invalid" />
		<s:State name="ready" />
		<s:State name="loading" />
		<s:State name="uninitialized" />
	</s:states>
			
		<s:BitmapImage id="imageDisplay"/>

	
	<!-- Preloader -->
	<s:Range id="progressIndicator" skinClass="com.squidzoo.skins.imageSkins.CustomImageLoadingSkin" 
			 verticalCenter="0" horizontalCenter="0" includeIn="loading" />
	
</s:Skin>
