<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:components="spark.components.*"
		title="Post Comment"
		xmlns:customComponents="com.squidzoo.friendify.customComponents.*">
	
	<fx:Script>
		<![CDATA[
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomDataEvent;
			private function onChange(event:Event):void{
				EventCentral.getInstance().dispatchEvent(new CustomDataEvent(CustomDataEvent.NEW_USER_COMMENT,textArea.text));
			}
		]]>
	</fx:Script>
	
	<s:VGroup width="100%"
			  height="100%"
			  paddingBottom="5"
			  paddingLeft="5"
			  paddingRight="5"
			  paddingTop="10">
		<s:TextArea id="textArea" width="100%" height="200" change="onChange(event)"/>
	</s:VGroup>
</s:View>
