<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009"
				 xmlns:s="library://ns.adobe.com/flex/spark"
				 xmlns:components="spark.components.*"
				 viewActivate="onViewActivate()"
				 title="Message Thread"
				 currentState="loading" xmlns:loadingAndErrorMessage="com.squidzoo.friendify.customComponents.loadingAndErrorMessage.*">
	
	<s:states>
		<s:State name="loading"/>
		<s:State name="error"/>
		<s:State name="complete"/>
	</s:states>
	
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			
			[Bindable]private var _dp:ArrayCollection = new ArrayCollection();
			
			private function onViewActivate():void
			{
				var posts:Array = data.comments.data;
				
				for(var i:uint = 0; i < posts.length; i++){
					var vo:Object = new Object();
					
					vo.id = posts[i].id;
					
					vo.from = new Object();
					vo.from.id = posts[i].from.id;
					vo.from.name = posts[i].from.name;
					
					vo.message = posts[i].message;					
					_dp.addItem(vo);
				}
				currentState = "complete";
			}
			
		]]>
	</fx:Script>
	
	<!--loading,error state-->
	<s:VGroup width="100%"
			  height="100%"
			  includeIn="loading,error"
			  verticalCenter="0"
			  horizontalCenter="0"
			  verticalAlign="middle"
			  horizontalAlign="center">
		<loadingAndErrorMessage:LoadingAndErrorMessageComponent id="loadingMessage"
																message="Loading content..."
																includeIn="loading"/>
		<loadingAndErrorMessage:LoadingAndErrorMessageComponent id="errorMessage"
																message="Error loading content..."
																includeIn="error"/>
	</s:VGroup>
	<!--complete state-->
	<s:VGroup width="100%" height="100%" includeIn="complete">
		<s:List dataProvider="{_dp}" itemRenderer="com.squidzoo.friendify.itemrenderers.MessageItemRenderer"
				useVirtualLayout="false"
				width="100%" height="100%"
				contentBackgroundAlpha="0">
			<s:layout>
				<s:VerticalLayout/>
			</s:layout>
		</s:List>
	</s:VGroup>
	
</s:View>
