<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009"
					  xmlns:s="library://ns.adobe.com/flex/spark"
					  xmlns:views="com.squidzoo.views.*"
					  title="Groups"
					  viewActivate="onViewActivate()" 
					  viewDeactivate="onViewDeactivate()"
					  xmlns:loadingAndErrorMessage="com.squidzoo.friendify.customComponents.loadingAndErrorMessage.*">

	<s:states>
		<s:State name="loading"/>
		<s:State name="error"/>
		<s:State name="complete"/>
	</s:states>
	
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			
			import com.squidzoo.services.FBService;
			

			private var _service:FBService=new FBService();
			[Bindable]
			private var _groups:ArrayCollection;

			private function onViewActivate():void
			{
				_service.addEventListener(FBService.GET_GROUPS_ERROR, onGetGroupsError);
				_service.addEventListener(FBService.GET_GROUPS_SUCCESS, onGetGroupsSuccess);
				_service.getGroups();
			}
			
			private function onViewDeactivate():void{
				if(_service.hasEventListener(FBService.GET_GROUPS_ERROR)){
					_service.removeEventListener(FBService.GET_GROUPS_ERROR, onGetGroupsError);
				}
				if(_service.hasEventListener(FBService.GET_GROUPS_SUCCESS)){
					_service.removeEventListener(FBService.GET_GROUPS_SUCCESS, onGetGroupsSuccess);
				}
				if(list && list.hasEventListener(MouseEvent.CLICK)){
					list.removeEventListener(MouseEvent.CLICK,onClickList);
				}
			}

			private function onGetGroupsError(event:Event):void
			{
				_service.removeEventListener(FBService.GET_GROUPS_ERROR, onGetGroupsError);
				_service.removeEventListener(FBService.GET_GROUPS_SUCCESS, onGetGroupsSuccess);	
				currentState="error";
			}

			private function onGetGroupsSuccess(event:Event):void
			{
				_service.removeEventListener(FBService.GET_GROUPS_ERROR, onGetGroupsError);
				_service.removeEventListener(FBService.GET_GROUPS_SUCCESS, onGetGroupsSuccess);
				_groups=_service.groups;
				currentState="complete";
			}

			private function onClickList():void
			{
				navigator.pushView(SingleGroupView, list.selectedItem);
			}
		]]>
	</fx:Script>


	
	<!--loading,error state-->
	<s:VGroup width="100%"
			  height="100%"
			  includeIn="loading,error"
			  verticalCenter="0"
			  horizontalCenter="0"
			  verticalAlign="middle"
			  horizontalAlign="center">
		<loadingAndErrorMessage:LoadingAndErrorMessageComponent id="loadingMessage"
																message="Loading content..."
																includeIn="loading"/>
		<loadingAndErrorMessage:LoadingAndErrorMessageComponent id="errorMessage"
																message="Error loading content..."
																includeIn="error"/>
	</s:VGroup>
	
	<s:VGroup width="100%"
			  height="100%"
			  includeIn="complete">
		<s:List id="list"
				width="100%"
				height="100%"
				dataProvider="{_groups}"
				itemRenderer="com.squidzoo.friendify.itemrenderers.GroupItemRenderer"
				contentBackgroundAlpha="0"
				click="onClickList()"/>
	</s:VGroup>


</s:View>
