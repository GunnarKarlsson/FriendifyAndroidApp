<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009" 
				 xmlns:s="library://ns.adobe.com/flex/spark" 
				 actionBarVisible="false">
	
	<fx:Style>
		@namespace s "library://ns.adobe.com/flex/spark";
		
		.tabbedStyle #tabBar
		{
			chromeColor: #000000;
			color: #f44b9e;
		}
	</fx:Style>
	
	<s:TabbedViewNavigator width="100%" height="100%"
						   styleName="tabbedStyle">
		
		<s:ViewNavigator label="Guests" width="100%" height="100%" 
						 firstView="views.eventsViews.SingleEventGuestView" firstViewData="{data}"
						 icon="@Embed('assets/images/icons/metalFriendsSmallVersion.png')"/>
		
		<s:ViewNavigator label="Wall" width="100%" height="100%" 
						 firstView="views.user.SingleUserWallView" firstViewData="{data}"
						 icon="@Embed('assets/images/icons/metalWallSmall001.png')"/>
	</s:TabbedViewNavigator>
	
</s:View>
