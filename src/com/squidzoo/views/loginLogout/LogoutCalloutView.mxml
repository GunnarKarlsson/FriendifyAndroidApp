<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009" 
				 xmlns:s="library://ns.adobe.com/flex/spark" xmlns:components="spark.components.*" title="Log-out">
	
	<fx:Script>
		<![CDATA[
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomEvent;
			
			private function onClick():void{
				EventCentral.getInstance().dispatchEvent(new CustomEvent(CustomEvent.LOG_OUT_CLICKED));
			}
			
		]]>
	</fx:Script>
	
	<s:VGroup width="100%" height="100%" paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="10">
		<s:Button label="Confirm log-out" id="logoutButton" click="onClick()"/>			
	</s:VGroup>
	
</s:View>
