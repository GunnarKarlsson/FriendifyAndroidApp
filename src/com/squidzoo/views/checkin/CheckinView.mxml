<?xml version="1.0" encoding="utf-8"?>
<components:View xmlns:fx="http://ns.adobe.com/mxml/2009" 
				 xmlns:s="library://ns.adobe.com/flex/spark" xmlns:components="spark.components.*" actionBarVisible="false">
	
	<fx:Style>
		@namespace s "library://ns.adobe.com/flex/spark";
		
		.tabbedStyle #tabBar
		{
			chromeColor: #000000;
			color: #f44b9e;
		}
	</fx:Style>
	
	<s:TabbedViewNavigator width="100%" height="100%" styleName="tabbedStyle">
	
	<s:ViewNavigator id="firstViewNav" label="Checkin Wall" width="100%" height="100%" 
					 firstView="views.checkin.CheckinsWallView" firstViewData="{data}"
					 icon="@Embed('assets/images/icons/metalWallSmall001.png')"/>
	<s:ViewNavigator label="Nearby Places" width="100%" height="100%" 
					 firstView="views.checkin.CloseLocationsView" firstViewData="{data}"
					 icon="@Embed('assets/images/icons/metalMapSmall001.png')"/>
	<s:ViewNavigator label="Post Checkin" width="100%" height="100%" 
					 firstView="views.checkin.CheckinPlaceSelectionView" firstViewData="{data}"
					 icon="@Embed('assets/images/icons/metalLocationSmall001.png')"/>
		</s:TabbedViewNavigator>
</components:View>
