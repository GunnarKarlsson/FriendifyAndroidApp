<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark"
		title="Post To Wall"
		width="100%"
		height="100%"
		xmlns:customComponents="com.squidzoo.friendify.customComponents.*">

	<fx:Script>
		<![CDATA[
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomDataEvent;

			private function onMessageChange():void
			{
				EventCentral.getInstance().dispatchEvent(new CustomDataEvent(CustomDataEvent.NEW_WALL_POST_MESSAGE, message.text));
			}
		]]>
	</fx:Script>
<s:SkinnableContainer width="100%" height="100%">	
	<s:VGroup width="100%"
			  height="100%"
			  paddingBottom="5"
			  paddingLeft="5"
			  paddingRight="5"
			  paddingTop="10">
		<s:Label text="What's on your mind:"
				 styleName="headerTextBlack"/>
		<s:TextInput prompt="your message"
					 id="message"
					 width="100%"
					 change="onMessageChange()"/>
	</s:VGroup>
</s:SkinnableContainer>
</s:View>
