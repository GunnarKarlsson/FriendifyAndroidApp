<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009"
					  xmlns:s="library://ns.adobe.com/flex/spark"
					  width="100%"
					  height="100"
					  contentBackgroundAlpha="0"
					  backgroundAlpha="0">

	<fx:Script>
		<![CDATA[
			import com.squidzoo.VOs.CommentVO;
			import com.squidzoo.VOs.NewsFeedVO;
			
			import com.facebook.graph.FacebookMobile;
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomDataEvent;
			
			import com.squidzoo.services.FBService;

			[Bindable]
			private var _dataObject:CommentVO;

			private var _service:FBService=new FBService();
			
			public function set dataObject(value:CommentVO):void
			{
				_dataObject=value as CommentVO;
				setUserLike();
				setNumLikes();
				setDeleteButton();
			}
				
			private function setUserLike():void
			{
				if (_dataObject.hasOwnProperty("userLikes"))
				{
					if (_dataObject.userLikes == false)
					{
						likeButton.label='Like';
					}
					else
					{
						likeButton.label='UnLike';
					}
				}
			}
			
			private function setNumLikes():void{
				if(_dataObject.likes == 0){
					likesCount.text = "";
					likeIcon.visible = false;
					likeIcon.includeInLayout = false;
				}else if(_dataObject.likes == 1){
					likesCount.text = "1 like";
					likeIcon.visible = true;
					likeIcon.includeInLayout = true;
				}else{
					likesCount.text = _dataObject.likes + ' likes';
					likeIcon.visible = true;
					likeIcon.includeInLayout = true;
				}
				
			}
			
			private function setDeleteButton():void{
				if(_dataObject.from.id == FacebookMobile.getSession().uid){
					deleteButton.includeInLayout = true;
					deleteButton.visible = true;
				}
			}
			
			private function onGetSourceObjectError(event:Event):void{
				currentState = "error";
			}
			
			private function onClickLikeButton():void
			{
				bi.visible=true;
				likeButton.label="....."
				if (_dataObject.userLikes)
				{
					FacebookMobile.deleteObject('/' + _dataObject.id + '/likes', handlePostUnliked);
				}
				else
				{
					FacebookMobile.api('/' + _dataObject.id + '/likes', handlePostLiked, null, "POST");
				}
			}
			
			private function handlePostUnliked(response:Object, fail:Object):void
			{
				bi.visible=false;
				if (response)
				{
					_dataObject.likes--;
					_dataObject.userLikes=false;
					setUserLike();
					setNumLikes();
				}
			}
			
			private function handlePostLiked(response:Object, fail:Object):void
			{
				bi.visible=false;
				if (response)
				{
					(_dataObject.likes == 0) ? _dataObject.likes=1 : _dataObject.likes++;
					_dataObject.userLikes=true;
					setUserLike();
					setNumLikes();
				}
			}
			
			private function onClickDeleteButton():void{
				bi.visible = true;
				FacebookMobile.deleteObject('/' + _dataObject.id, handleCommentDeleted);
			}
			
			private function handleCommentDeleted(success:Object,fail:Object):void{
				if(success){
					EventCentral.getInstance().dispatchEvent(new CustomDataEvent(CustomDataEvent.COMMENT_DELETED,_dataObject.id));
				}
			}
		]]>
	</fx:Script>

	<s:HGroup x="0" paddingBottom="0" paddingLeft="0" paddingRight="0"
			  paddingTop="0" verticalAlign="middle" horizontalAlign="right" width="100%">
			<s:Button id="deleteButton" label="delete" 
					  height="35" minWidth="70"
					  fontSize="14"
					  includeInLayout="false" visible="false"
					  styleName="com.squidzoo.skins.SquareButtonSkin"
					  click="onClickDeleteButton()"/>
			<s:Button id="likeButton" label="like" height="35" minWidth="70"
				  fontSize="14"
				  click="onClickLikeButton()"
				  styleName="com.squidzoo.skins.SquareButtonSkin"/>
			<s:Image id="likeIcon"
				 source="@Embed('assets/images/icons/metalLike001.png')"
				 />
			<s:Label id="likesCount"
				 styleName="bodyTextBlack"
				 text="Be the first to like this"/>		
			<s:BusyIndicator id="bi"
						 symbolColor="black"
						 visible="false"
						 left="10"/>
			
	</s:HGroup>

</s:SkinnableContainer>