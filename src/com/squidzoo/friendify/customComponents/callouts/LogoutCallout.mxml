<?xml version="1.0" encoding="utf-8"?>
<components:Callout xmlns:fx="http://ns.adobe.com/mxml/2009"
					xmlns:s="library://ns.adobe.com/flex/spark"
					xmlns:components="spark.components.*"
					width="100%"
					height="100%"
					creationComplete="creationCompleteHandler(event)">

	<fx:Script>
		<![CDATA[
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomEvent;
			
			import mx.events.FlexEvent;

			protected function creationCompleteHandler(event:FlexEvent):void
			{
				EventCentral.getInstance().addEventListener(CustomEvent.LOG_OUT_CLICKED, onLogoutClicked);
			}

			private function onLogoutClicked(event:Event):void
			{
				EventCentral.getInstance().removeEventListener(CustomEvent.LOG_OUT_CLICKED, onLogoutClicked);
				this.close(true);	
			}
		]]>
	</fx:Script>

	<s:ViewNavigator id="viewNav"
					 width="100%"
					 height="100%"
					 firstView="views.LogoutCalloutView">
		<s:navigationContent>
			<s:Image source="@Embed('assets/images/icons/metalLogout001.png')"/>
		</s:navigationContent>
		<s:actionContent>
			<s:Button label="Cancel"
					  click="close(false)"/>
		</s:actionContent>
	</s:ViewNavigator>

</components:Callout>
