<?xml version="1.0" encoding="utf-8"?>
<components:Callout xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark" xmlns:components="spark.components.*" width="100%" height="100%"
					creationComplete="creationCompleteHandler()"
					>

	<fx:Script>
		<![CDATA[
			import com.facebook.graph.FacebookMobile;
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomDataEvent;
			
			import flashx.textLayout.tlf_internal;
			
			import mx.managers.SystemManager;
			
			[Bindable]public var selection:String = "";
			
			private function creationCompleteHandler():void{
				EventCentral.getInstance().addEventListener(CustomDataEvent.MAIN_MENU_BUTTON_CLICKED,onMainMenuButtonClicked);
			}
			
			private function onMainMenuButtonClicked(event:CustomDataEvent):void{
				
				if(event.data == ""){
					this.close(false);
				}else{
					var params:Object = new Object();
					params.label = event.data;
					this.close(true,params);
				}
			}
		]]>
	</fx:Script>
	
	<s:ViewNavigator id="viewNav" width="100%" height="100%" firstView="views.mainMenu.MainMenuView">
		<s:navigationContent>
			<s:Image source="@Embed('assets/images/icons/metalHomeSmall001.png')"/>
		</s:navigationContent>
		<s:actionContent>
			<s:Button label="Cancel" click="close(false)"/>
		</s:actionContent>
	</s:ViewNavigator>
	
</components:Callout>
