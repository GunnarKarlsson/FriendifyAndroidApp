<?xml version="1.0" encoding="utf-8"?>
<components:Callout xmlns:fx="http://ns.adobe.com/mxml/2009"
					xmlns:s="library://ns.adobe.com/flex/spark"
					xmlns:components="spark.components.*"
					width="100%"
					height="100%"
					creationComplete="init()">


	<fx:Script>
		<![CDATA[
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomDataEvent;

			[Bindable]
			public var _message:String="";

			public function cleanUp():void
			{
				EventCentral.getInstance().removeEventListener(CustomDataEvent.NEW_WALL_POST_MESSAGE, onMessage);
			}

			private function init():void
			{
				EventCentral.getInstance().addEventListener(CustomDataEvent.NEW_WALL_POST_MESSAGE, onMessage);
			}

			private function onMessage(event:CustomDataEvent):void
			{
				_message=event.data;
			}

			private function onClickPost():void
			{

				if (_message != "")
				{
					var params:Object=new Object();
					params.message=_message;
					this.close(true, params);
				}
				else
				{
					this.close(false);
				}
			}
		]]>
	</fx:Script>

	<s:ViewNavigator id="viewNav"
					 width="100%"
					 height="100%"
					 firstView="views.newsfeed.PostToWallView">
		<s:navigationContent>
			<s:Button label="Cancel"
					  click="close(false)"/>
		</s:navigationContent>
		<s:actionContent>
			<s:Button id="done"
					  label="Post"
					  emphasized="true"
					  click="onClickPost()"/>
		</s:actionContent>
	</s:ViewNavigator>

</components:Callout>
