<?xml version="1.0" encoding="utf-8"?>
<s:SkinnablePopUpContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
						   xmlns:s="library://ns.adobe.com/flex/spark" width="100%" height="{_stageHeight}"
						   
						   creationComplete="creationCompleteHandler(event)">
	<fx:Script>
		<![CDATA[
			import com.facebook.graph.FacebookMobile;
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomDataEvent;
			
			import flashx.textLayout.tlf_internal;
			
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.managers.SystemManager;
			
			[Bindable]public var selection:String = "";
			
			[Bindable]private var _stageHeight:int;
			
			private function creationCompleteHandler(event:FlexEvent):void{
				EventCentral.getInstance().addEventListener(CustomDataEvent.MAIN_MENU_BUTTON_CLICKED,onMainMenuButtonClicked);
				_stageHeight = FlexGlobals.topLevelApplication.stage.stageHeight;
			}
			
			private function onMainMenuButtonClicked(event:CustomDataEvent):void{
				EventCentral.getInstance().removeEventListener(CustomDataEvent.MAIN_MENU_BUTTON_CLICKED,onMainMenuButtonClicked);
				if(event.data == ""){
					this.close(false);
				}else{
					var params:Object = new Object();
					params.label = event.data;
					this.close(true,params);
				}
			}
			
		]]>
	</fx:Script>
	
	<s:ViewNavigator id="viewNav" width="100%" height="100%" firstView="views.MainMenuView">
	</s:ViewNavigator>
	
</s:SkinnablePopUpContainer>
