<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009"
				xmlns:s="library://ns.adobe.com/flex/spark"
				width="100%"
				
				autoDrawBackground="false"
				contentBackgroundAlpha="0"
				xmlns:styles="com.squidzoo.styles.*"
				xmlns:customComponents="com.squidzoo.friendify.customComponents.*">

	<fx:Declarations>
		<styles:GraphicsLib id="graphicsLib"/>
	</fx:Declarations>

	<s:states>
		<s:State name="startState"/>
		<s:State name="newFriendsState"/>
	</s:states>

	<fx:Script>
		<![CDATA[
			import com.facebook.graph.FacebookMobile;

			import flashx.textLayout.conversion.TextConverter;
			import flashx.textLayout.elements.Configuration;
			import flashx.textLayout.elements.TextFlow;
			import flashx.textLayout.formats.TextDecoration;
			import flashx.textLayout.formats.TextLayoutFormat;

			import mx.collections.ArrayCollection;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;

			import spark.components.VGroup;

			import com.squidzoo.utils.FacebookTimeParser;
			import com.squidzoo.utils.RelativeDate;

			import com.squidzoo.views.comments.CommentsView;
			import com.squidzoo.views.friends.PeopleList;

			[Bindable]
			private var thumbnailUrl:String;
			[Bindable]
			private var pictureurl:String;
			[Bindable]
			private var theName:String;

			private var storyTags:Object;

			[Bindable]
			private var commentsDataProvider:ArrayCollection=new ArrayCollection();

			override public function set data(value:Object):void
			{
				if (value == null || (data && data.id == value.id))
				{
					return;
				}

				super.data=value;

				if (value.from)
				{
					nameField.text=value.from.name;
					thumbnail.source=FacebookMobile.getImageUrl(value.from.id.toString(), 'square');
				}

				if (value.message)
				{
					message.text=value.message;
				}
				else if (value.story)
				{
					message.text=value.story;
				}
				else
				{
					message.includeInLayout=false;
				}

				if (value.storyTags && value.story)
				{
					storyTags=value.storyTags;
					picAndBody.includeInLayout=false;
					currentState="newFriendsState";
				}

				if (value.picture)
				{
					picture.source=value.picture;
				}
				else
				{
					picture.includeInLayout=false;
				}

				if (value.comments != null)
				{
					commentsDataProvider.source=(value.comments.data) ? value.comments.data : [];
				}

				if (value.link)
				{
					var txt:String="<a href='" + value.link + "' target='_top'>" + value.name + "</a>.";
					var config:Configuration=TextFlow.defaultConfiguration;
					configureLink(config);
					link.textFlow=TextConverter.importToFlow(txt, TextConverter.TEXT_FIELD_HTML_FORMAT, config);
				}
				else
				{
					link.includeInLayout=false;
				}

				if (value.caption)
				{
					caption.text=value.caption;
				}
				else
				{
					caption.includeInLayout=false;
				}

				if (value.description)
				{
					description.text=value.description;
				}
				else
				{
					description.includeInLayout=false;
				}

				if (value.created_time)
				{
					var date:Date=FacebookTimeParser.parseDate(value.created_time);
					createdTime.text=RelativeDate.getRelativeDateFromNow(date, false);
				}

				if (link.includeInLayout == false && caption.includeInLayout == false && description.includeInLayout == false && picture.includeInLayout == false)
				{
					picAndBody.includeInLayout=false;
				}

			}

			private function configureLink(config:Configuration):void
			{
				var normalFmt:TextLayoutFormat=new TextLayoutFormat(config.defaultLinkNormalFormat);
				normalFmt.color=0x444444;
				normalFmt.textDecoration=TextDecoration.NONE;

				var hoverFmt:TextLayoutFormat=new TextLayoutFormat(config.defaultLinkHoverFormat);
				hoverFmt.color=0x555555;
				hoverFmt.textDecoration=TextDecoration.UNDERLINE;

				config.defaultLinkNormalFormat=normalFmt;
				config.defaultLinkHoverFormat=hoverFmt;
			}

		]]>
	</fx:Script>

	<s:HGroup width="100%"
			  height="100%"
			  paddingBottom="10"
			  paddingLeft="10"
			  paddingRight="10"
			  paddingTop="10">
		<s:SkinnableContainer id="outerBox"
							  skinClass="com.squidzoo.friendify.itemrenderers.newsFeedItemRenderer.skins.CommentsHeaderOuterSkin"
							  width="100%"
							  height="100%">

			<s:VGroup width="100%"
					  height="100%"
					  paddingBottom="5"
					  paddingLeft="5"
					  paddingRight="5"
					  paddingTop="5"
					  gap="0">

				<s:SkinnableContainer id="topInnerBox"
									  skinClass="com.squidzoo.friendify.itemrenderers.newsFeedItemRenderer.skins.TopBox"
									  width="100%"
									  height="100%">
					<s:HGroup width="100%"
							  height="100%">

						<s:Group>

							<s:Rect id="portraitFrame"
									left="10"
									top="10"
									width="60"
									height="60">
								<s:fill>
									<s:LinearGradient rotation="90">
										<s:GradientEntry color="0xffffff"/>
										<s:GradientEntry color="0xffffff"/>
									</s:LinearGradient>
								</s:fill>
							</s:Rect>

						<s:Image id="thumbnail"
								 x="{portraitFrame.x+5}"
								 y="{portraitFrame.y+5}"
								 maxWidth="100"
								 maxHeight="100"/>
						</s:Group>
						<s:VGroup width="100%"
								  height="100%"
								  paddingBottom="10"
								  paddingLeft="10"
								  paddingRight="10"
								  paddingTop="10">

							<s:RichEditableText id="nameField"
												selectable="false"
												editable="false"
												multiline="true"
												width="100%"
												styleName="headerText"/>
							<s:RichEditableText id="message"
												width="100%"
												editable="false"
												multiline="true"
												selectable="false"
												styleName="bodyTextWhite"
												text="{message}"/>
						</s:VGroup>
					</s:HGroup>
				</s:SkinnableContainer>

				<s:SkinnableContainer id="middleBox"
									  width="100%"
									  height="100%"
									  skinClass="com.squidzoo.friendify.itemrenderers.newsFeedItemRenderer.skins.MiddleBox">
					<s:VGroup width="100%"
							  height="100%"
							  paddingLeft="10"
							  paddingRight="10"
							  paddingTop="10"
							  paddingBottom="20">
						<s:HGroup id="picAndBody"
								  width="100%"
								  height="100%"
								  paddingBottom="5"
								  paddingLeft="5"
								  paddingRight="5"
								  paddingTop="5">

							<s:Group>
								<s:Image id="picture"
										 left="5"
										 right="5"
										 maxWidth="100"
										 maxHeight="100"/>
							</s:Group>

							<s:VGroup width="100%"
									  height="100%"
									  paddingLeft="5"
									  paddingBottom="5"
									  paddingRight="5"
									  paddingTop="5">
								<s:RichEditableText id="link"
													selectable="false"
													editable="false"
													multiline="true"
													styleName="headerText"
													width="100%"/>
								<s:RichEditableText id="caption"
													selectable="false"
													editable="false"
													multiline="true"
													styleName="bodyText"
													width="100%"/>
							</s:VGroup>
						</s:HGroup>
						<s:RichEditableText id="description"
											selectable="false"
											editable="false"
											multiline="true"
											styleName="bodyTextBlack"
											width="100%"/>
						<s:RichEditableText id="createdTime"
											selectable="false"
											editable="false"
											multiline="true"
											styleName="timeText"
											width="100%"/>
					</s:VGroup>
				</s:SkinnableContainer>

			</s:VGroup>
		</s:SkinnableContainer>

	</s:HGroup>

</s:ItemRenderer>
