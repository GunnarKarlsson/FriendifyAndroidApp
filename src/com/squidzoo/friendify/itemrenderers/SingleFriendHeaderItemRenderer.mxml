<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark"  
					width="100%" height="100%" xmlns:mx="library://ns.adobe.com/flex/mx"
					autoDrawBackground="true"
					contentBackgroundColor="#999999" >
	
	<fx:Script>
		<![CDATA[
			import com.facebook.graph.FacebookMobile;
			
			import mx.core.FlexGlobals;
			
			import spark.core.ContentCache;
			
			[Bindable]private var _imageCache:ContentCache = FlexGlobals.topLevelApplication.imageCache;
			
			[Bindable]private var _imageSource:String;
			
			public var _type:String = "FriendHeader";
			
			override public function set data(value:Object):void {
				
				super.data = value;
				
				if (data == null)
				{					
					return;
				}
				
				if(value.hasOwnProperty("name"))
				{
					nameLabel.text = value.name as String;	
				}
				
				if(value.hasOwnProperty("id"))
				{
					_imageSource = FacebookMobile.getImageUrl(value.id,'normal');
				}
				
				if(value.hasOwnProperty("homeTown") && value.homeTown!=null){
					locationLabel.text = "lives in "+value.homeTown;	
				}
				
				if(value.hasOwnProperty("relationShipStatus") && value.relationShipStatus!=null){
					relationShipStatusLabel.text = value.relationShipStatus;
				}
				
				if(value.hasOwnProperty("birthday")){
					birthdayLabel.text = value.birthday;
				}
			}
		]]>
	</fx:Script>
	
	<s:HGroup width="100%" height="100%" paddingBottom="20" paddingLeft="20" paddingRight="20" paddingTop="20" >
		
	<s:Image id="image" backgroundColor="#888888" 
			 contentLoader="{_imageCache}" source="{_imageSource}"
			 minWidth="60" minHeight="60"
			 enableLoadingState="true"/>		
				
	<s:VGroup>	
			<s:Label id="nameLabel" styleName="headerText"/>
			<s:Label id="locationLabel" styleName="bodyText"/>
			<s:Label id="relationShipStatusLabel" styleName="bodyText"/>
			<s:Label id="birthdayLabel" styleName="bodyText"/>	
	</s:VGroup>
	
	</s:HGroup>
	
</s:ItemRenderer>
