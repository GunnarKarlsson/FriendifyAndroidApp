<?xml version="1.0" encoding="utf-8"?>
<s:IconItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark"  
					labelFunction="getLabel" messageFunction="getMessage" iconFunction="getIcon" 
					iconWidth="30" iconHeight="30" 
					>

	<fx:Script>
		<![CDATA[
			public function getLabel(item:Object):String{
				return item.label;
			}
			public function getMessage(item:Object):String{
				return item.message;
			}
			
			public function getIcon(item:Object):String{
				return item.icon;
			}
		]]>
	</fx:Script>

</s:IconItemRenderer>
