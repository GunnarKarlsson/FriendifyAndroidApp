<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" width="100%"
				creationComplete="creationCompleteHandler(event)"
				autoDrawBackground="false"
				contentBackgroundAlpha="0" xmlns:styles="com.squidzoo.styles.*">
	
	<fx:Declarations>
		<styles:GraphicsLib id="graphicsLib"/>
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import com.squidzoo.VOs.PhotoVO;
			
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.core.ContentCache;
			
			[Bindable]private var _imageCache:ContentCache = FlexGlobals.topLevelApplication.imageCache;
			
			protected function creationCompleteHandler(event:FlexEvent):void
			{
				image.source=(data as PhotoVO).sourceLarge;			
			}
			
		]]>
	</fx:Script>
	<s:VGroup width="100%" height="100%">		
		<s:Image id="image" width="200" height="200"
				 contentLoader="{_imageCache}"
				 enableLoadingState="true"
				 filters="{[graphicsLib.getDropShadowFilter()]}"
				 verticalAlign="middle" horizontalAlign="center">
		</s:Image>
	</s:VGroup>
		
</s:ItemRenderer>