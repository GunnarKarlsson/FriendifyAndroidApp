<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009"
				xmlns:s="library://ns.adobe.com/flex/spark"
				width="100%"
				height="100%"
				creationComplete="creationCompleteHandler(event)"
				autoDrawBackground="false"
				contentBackgroundAlpha="0">
	<fx:Script>
		<![CDATA[
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.events.ResizeEvent;

			import spark.components.ActionBar;

			[Bindable]
			private var _width:uint;
			[Bindable]
			private var _height:uint;

			protected function creationCompleteHandler(event:FlexEvent):void
			{
				trace("ppir cc");
				addEventListener(ResizeEvent.RESIZE, onResize);

				//_width	=	FlexGlobals.topLevelApplication.stage.stageWidth;
				//_height	=	FlexGlobals.topLevelApplication.stage.stageHeight;

				image.source=data.sourceXtraLarge;
				trace("image.width: "+image.width);
				trace("image.height: "+image.height);
			}

			protected function onResize(event:ResizeEvent):void
			{
				_width=FlexGlobals.topLevelApplication.stage.stageWidth;
				_height=FlexGlobals.topLevelApplication.stage.stageHeight;
			}
		]]>
	</fx:Script>
	<s:VGroup width="100%"
			  height="100%"
			  verticalCenter="0"
			  horizontalCenter="0"
			  verticalAlign="middle"
			  horizontalAlign="center">
		<s:Image id="image"
				 width="100%"
				 height="100%"
				 enableLoadingState="true"/>
	</s:VGroup>

</s:ItemRenderer>