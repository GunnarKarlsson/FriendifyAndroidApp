<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" width="100%" height="100%"
				autoDrawBackground="false"
				contentBackgroundAlpha="0" xmlns:styles="styles.*" xmlns:customComponents="customComponents.*">
	
<fx:Declarations>
<styles:GraphicsLib id="graphicsLib"/>
</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import cache.ImageCache;
			
			import com.facebook.graph.FacebookMobile;
			
			import mx.core.FlexGlobals;
			
			import spark.core.ContentCache;
			
			private var userId:String;
			
			[Bindable]private var _imageSource:String;
			
			[Bindable]private var _imageCache:ContentCache = FlexGlobals.topLevelApplication.imageCache;
			
			override public function set data(value:Object):void {
				if (value == null || (data && data.id == value.id)) { return; }
				
				super.data = value;
				var pattern:RegExp = /\b\d+\b/;
				userId = value.id.match(pattern).toString();
				FacebookMobile.api('/'+userId, handleResponse);
			}
			
			private function handleResponse(success:Object,fail:Object):void{
				if(success){
					nameField.text = success.first_name +" "+ success.last_name;
					data.name = nameField.text;
				}else{
					nameField.text = "name not retrieved";
					data.name = nameField.text;
				}
				
				_imageSource = FacebookMobile.getImageUrl(userId,"square");
			}
			
		]]>
	</fx:Script>
	
	
<customComponents:PortraitFrame id="portraitFrame"/>
	
	<s:Image id="thumbnail"
			 x="{portraitFrame.x+5}"
			 y="{portraitFrame.y+5}"
			 width="50"
			 height="50"
			 source="{_imageSource}"
			 contentLoader="{_imageCache}"
			 enableLoadingState="true"
			 backgroundColor="{graphicsLib.getImageBackGroundColor()}"/>
	
	<s:HGroup x="{portraitFrame.x + portraitFrame.width}"
			  width="100%"
			  height="100%"
			  paddingBottom="20"
			  paddingLeft="0"
			  paddingRight="20"
			  paddingTop="10">
		<s:SkinnableContainer id="outerBox"
							  skinClass="itemrenderers.newsFeedItemRenderer.skins.NewsFeedSkin"
							  width="100%"
							  height="100%">
			
			<s:VGroup width="100%"
					  height="100%"
					  paddingBottom="5"
					  paddingLeft="5"
					  paddingRight="5"
					  paddingTop="5"
					  gap="0">
				
				<s:SkinnableContainer id="topInnerBox"
									  skinClass="itemrenderers.newsFeedItemRenderer.skins.TopBox"
									  width="100%"
									  height="100%">
					<s:VGroup width="100%"
							  height="100%"
							  paddingBottom="10"
							  paddingLeft="10"
							  paddingRight="10"
							  paddingTop="20">
						
						<s:RichEditableText id="nameField"
											selectable="false"
											editable="false"
											multiline="true"
											width="100%"
											styleName="headerText"/>
					</s:VGroup>
				</s:SkinnableContainer>
				
				
			</s:VGroup>
		</s:SkinnableContainer>
		
	</s:HGroup>
	
</s:ItemRenderer>
