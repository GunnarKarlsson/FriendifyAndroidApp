<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark"  width="100%" height="100%">
	
	<fx:Script>
		<![CDATA[
			import com.facebook.graph.FacebookMobile;
			
			import mx.core.FlexGlobals;
			
			[Bindable]private var _messageWidth:int = FlexGlobals.topLevelApplication.stage.stageWidth - 100;
			
			override public function set data(value:Object):void {
				if (value == null || (data && data.id == value.id)) { return; }
				
				super.data = value;

				story.text = value.story;
			}
			
		]]>
	</fx:Script>
	
	<s:HGroup paddingBottom="10" paddingLeft="10" paddingRight="10" paddingTop="10">
		<s:TextArea id="story" width="{_messageWidth}"
					selectable="false" editable="false" borderVisible="false" contentBackgroundAlpha="0"/>
	</s:HGroup>
	
</s:ItemRenderer>
