<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" width="100%"
				autoDrawBackground="false"
				contentBackgroundAlpha="0"
				>

	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			override public function set data(value:Object):void{
				if(value == data || value == null)
				{
					return;
				}
				messageLabel.text = value.message;
			}
			
		]]>
	</fx:Script>
	
	<s:HGroup width="100%" height="100%" paddingBottom="10" paddingLeft="10" paddingRight="10" paddingTop="10">
		<s:Label id="messageLabel" color="#bbbbbb"/>
	</s:HGroup>
</s:ItemRenderer>
