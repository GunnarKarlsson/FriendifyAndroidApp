<?xml version="1.0" encoding="utf-8"?>
<components:Callout xmlns:fx="http://ns.adobe.com/mxml/2009"
					xmlns:s="library://ns.adobe.com/flex/spark"
					xmlns:components="spark.components.*"
					width="100%"
					height="100%"
					creationComplete="onCreationComplete()">

	<fx:Script>
		<![CDATA[
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomDataEvent;

			[Bindable]
			private var personName:String="";
			[Bindable]
			private var searchScope:String = "friends";//default search for friends, not everyone

			private function onCreationComplete():void
			{
				EventCentral.getInstance().addEventListener(CustomDataEvent.NEW_FRIENDS_SEARCH_NAME, onName);
				EventCentral.getInstance().addEventListener(CustomDataEvent.NEW_FRIENDS_SEARCH_SCOPE, onScope);
			}

			private function onName(event:CustomDataEvent):void
			{

				personName=event.data;
			}

			private function onScope(event:CustomDataEvent):void
			{

				searchScope=event.data;
			}

			private function onClickSearch():void
			{
				EventCentral.getInstance().removeEventListener(CustomDataEvent.NEW_FRIENDS_SEARCH_NAME, onName);
				EventCentral.getInstance().removeEventListener(CustomDataEvent.NEW_FRIENDS_SEARCH_SCOPE, onScope);
				if (personName != "")
				{
					var params:Object=new Object();
					params.searchScope=searchScope;
					params.personName=personName;
					this.close(true, params);
				}
				else
				{
					this.close(false);
				}
			}
		]]>
	</fx:Script>

	<s:ViewNavigator id="viewNav"
					 width="100%"
					 height="100%"
					 firstView="views.friends.SearchFriendsView">
		<s:navigationContent>
			<s:Button label="Cancel"
					  click="close(false)"/>
		</s:navigationContent>
		<s:actionContent>
			<s:Button id="searchButton"
					  label="Search"
					  emphasized="true"
					  click="onClickSearch()"/>
		</s:actionContent>
	</s:ViewNavigator>

</components:Callout>
