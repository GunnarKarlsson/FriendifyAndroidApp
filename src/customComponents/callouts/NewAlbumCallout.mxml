<?xml version="1.0" encoding="utf-8"?>
<components:Callout xmlns:fx="http://ns.adobe.com/mxml/2009" 
					xmlns:s="library://ns.adobe.com/flex/spark" xmlns:components="spark.components.*" width="100%" height="100%"
					creationComplete="init()">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	<fx:Script>
		<![CDATA[
			import com.facebook.graph.FacebookMobile;
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomDataEvent;
			
			import flashx.textLayout.tlf_internal;
			
			import mx.managers.SystemManager;
			
			[Bindable]public var albumName:String = "";
			[Bindable]public var albumDescription:String = "";
			
			public function cleanUp():void{
				EventCentral.getInstance().removeEventListener(CustomDataEvent.NEW_ALBUM_DESC,onDesc);
				EventCentral.getInstance().removeEventListener(CustomDataEvent.NEW_ALBUM_NAME,onName);
			}
			
			private function init():void{
				EventCentral.getInstance().addEventListener(CustomDataEvent.NEW_ALBUM_DESC,onDesc);
				EventCentral.getInstance().addEventListener(CustomDataEvent.NEW_ALBUM_NAME,onName);
			}
			
			private function onName(event:CustomDataEvent):void{
				
				albumName = event.data;
				trace("newAlbumCallout albumname: "+albumName);
			}
			
			private function onDesc(event:CustomDataEvent):void{
				albumDescription = event.data;
			}
			
			private function onClickCreate():void{
			
				if(albumName != ""){
					var params:Object = new Object();
					params.message = albumName;
					params.name = 	albumDescription;
					this.close(true,params);
				}else{
					this.close(false);
				}
			}
		]]>
	</fx:Script>
	
	<s:ViewNavigator id="viewNav" width="100%" height="100%" firstView="views.photos.NewAlbumView">
		<s:navigationContent>
			<s:Button label="Cancel" click="close(false)"/>
		</s:navigationContent>
		<s:actionContent>
			<s:Button id="done" label="Create" emphasized="true" click="onClickCreate()"/>
		</s:actionContent>
	</s:ViewNavigator>
	
</components:Callout>
