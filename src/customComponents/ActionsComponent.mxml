<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009"
					  xmlns:s="library://ns.adobe.com/flex/spark"
					  width="100%"
					  height="60"
					  contentBackgroundAlpha="0"
					  backgroundAlpha="0"
					  creationComplete="init()">

	<fx:Script>
		<![CDATA[
			import VOs.NewsFeedVO;
			import com.squidzoo.eventSystem.EventCentral;
			import services.FBService;

			[Bindable]
			private var _dataObject:Object;//was NewsFeedVO

			private function init():void
			{
				//EventCentral.getInstance().addEventListener(FBService.GET_LIKES_DATA_FOR_NEWSFEED_SUCCESS,populateLikeCount);
				//EventCentral.getInstance().addEventListener(FBService.GET_LIKES_DATA_FOR_NEWSFEED_ERROR,onGetLikesError);
			}

			public function set dataObject(value:Object):void
			{
				_dataObject=value;

				populateLikeCount();
			}

			/*
			private function onGetLikesError(event:Event):void{
				trace("error getting likes data");
			}
			*/

			protected function populateLikeCount():void
			{
				likesCount.text=_dataObject.likesCount == 0 ? "" : _dataObject.likesCount + ' likes';
				if (likesCount.text.charAt(0) == "1")
				{
					likesCount.text="1 like";
				}
				commentsCount.text=_dataObject.commentsCount == 0 ? "" : _dataObject.commentsCount + ' comments';
				if (commentsCount.text.charAt(0) == "1")
				{
					commentsCount.text="1 comment";
				}

				if (_dataObject.likesCount < 1)
				{
					likeIcon.visible=false;
					likeIcon.includeInLayout=false;
				}else{
					likeIcon.visible=true;
					likeIcon.includeInLayout=true;
				}

				if (_dataObject.commentsCount < 1)
				{
					commentIcon.visible=false;
					commentIcon.includeInLayout=false;
				}else{
					commentIcon.visible=true;
					commentIcon.includeInLayout=true;
				}
			}
		]]>
	</fx:Script>

	<s:HGroup paddingBottom="0"
			  paddingLeft="0"
			  paddingRight="0"
			  paddingTop="0"
			  verticalAlign="middle">
		<s:Image id="likeIcon"
				 source="@Embed('assets/images/icons/metalLike001.png')"/>
		<s:Label id="likesCount" styleName="bodyTextWhite"/>
		<s:Image id="commentIcon"
				 source="@Embed('assets/images/icons/metalComment001.png')"/>
		<s:Label id="commentsCount" styleName="bodyTextWhite"/>
	</s:HGroup>

</s:SkinnableContainer>
