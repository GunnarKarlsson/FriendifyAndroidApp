<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009"
					  xmlns:s="library://ns.adobe.com/flex/spark"
					  skinClass="customComponents.loadingAndErrorMessage.LoadingAndErrorMessageSkin" xmlns:styles="styles.*"
					 >
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			[Bindable]
			private var _text:String = "";
			
			
			public function set message(value:String):void{
				if(value == null)
				{
					return;
				}
				_text = value;
			}
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<styles:GraphicsLib id="graphicsLib"/>
	</fx:Declarations>
	
	<s:VGroup 
			  paddingBottom="20"
			  paddingLeft="20"
			  paddingRight="20"
			  paddingTop="20"
			  verticalAlign="middle" horizontalAlign="center">
		<s:RichEditableText id="msg" text="{_text}" color="{graphicsLib.getLoadingMessageTextColor()}"/>
	</s:VGroup>
</s:SkinnableContainer>
