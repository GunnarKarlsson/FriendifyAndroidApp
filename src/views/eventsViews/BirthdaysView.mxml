<?xml version="1.0" encoding="utf-8"?>
<customComponents:CustomView xmlns:fx="http://ns.adobe.com/mxml/2009"
							 xmlns:s="library://ns.adobe.com/flex/spark"
							 xmlns:customComponents="customComponents.*"
							 title="Birthdays"
							 destructionPolicy="never"
							 viewActivate="onViewActivate()"
							 viewDeactivate="onViewDeactivate()"
							 currentState="loading"
							 xmlns:loadingAndErrorMessage="customComponents.loadingAndErrorMessage.*">
	<!--
	<s:navigationContent>
		<s:Button id="homeButton"
				  icon="@Embed('assets/images/icons/metalHome001.png')"
				  click="clickHomeButton()"/>
	</s:navigationContent>
	-->
	<customComponents:states>
		<s:State name="loading"/>
		<s:State name="error"/>
		<s:State name="complete"/>
	</customComponents:states>

	<fx:Script>
		<![CDATA[
			import com.facebook.graph.FacebookMobile;
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomDataEvent;
			import com.squidzoo.eventSystem.events.CustomEvent;

			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;

			import services.FBService;


			private var _service:FBService=new FBService();

			[Bindable]
			private var _dp:ArrayCollection=new ArrayCollection();

			private function clickHomeButton():void
			{
				EventCentral.getInstance().dispatchEvent(new CustomEvent(CustomEvent.PUSH_HOME_VIEW));
			}

			private function onViewActivate():void
			{
				var query:String="SELECT uid,name,birthday_date FROM user WHERE uid IN(SELECT uid2 FROM friend WHERE uid1=me())"
				FacebookMobile.fqlQuery(query, handleQuery);
			}

			override protected function onViewDeactivate():void
			{
				super.onViewDeactivate();
				if (list && list.hasEventListener(MouseEvent.CLICK))
				{
					list.removeEventListener(MouseEvent.CLICK, onClickList);
				}
			}

			private function onError(event:Event):void
			{
				trace("error getting events");
				currentState="error";
			}

			private function onSuccess(event:Event):void
			{
				_dp=_service.events;
				currentState="complete";
			}

			private function onClickList():void
			{

				EventCentral.getInstance().dispatchEvent(new CustomDataEvent(CustomDataEvent.PUSH_SINGLE_USER_VIEW, null, list.selectedItem));
			}

			private function handleQuery(success:Object, fail:Object):void
			{
				if (success)
				{

					var response:Array=success as Array;

					for (var i:uint=0; i < response.length; i++)
					{
						var vo:Object=new Object();
						vo.name=response[i].name;
						vo.id=response[i].uid;
						vo.birthday=response[i].birthday_date;
						_dp.addItem(vo);
					}
					currentState="complete";
				}
				else
				{
					currentState="error";
				}
			}
		]]>

	</fx:Script>

	<!--loading,error state-->
	<s:VGroup width="100%"
			  height="100%"
			  includeIn="loading,error"
			  verticalCenter="0"
			  horizontalCenter="0"
			  verticalAlign="middle"
			  horizontalAlign="center">
		<loadingAndErrorMessage:LoadingAndErrorMessageComponent id="loadingMessage"
																message="Loading content..."
																includeIn="loading"/>
		<loadingAndErrorMessage:LoadingAndErrorMessageComponent id="errorMessage"
																message="Error loading content..."
																includeIn="error"/>
	</s:VGroup>

	<s:VGroup width="100%"
			  height="100%">
		<s:List id="list"
				includeIn="complete"
				width="100%"
				height="100%"
				dataProvider="{_dp}"
				itemRenderer="itemrenderers.BirthdayItemRenderer"
				contentBackgroundAlpha="0"
				click="onClickList()"/>
	</s:VGroup>
</customComponents:CustomView>
