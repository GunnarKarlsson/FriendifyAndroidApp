<?xml version="1.0" encoding="utf-8"?>
<customComponents:CustomView xmlns:fx="http://ns.adobe.com/mxml/2009" 
							 xmlns:s="library://ns.adobe.com/flex/spark" xmlns:customComponents="customComponents.*" 
							 title="Friend requests"
							 viewActivate="onViewActivate()" 
							 viewDeactivate="onViewDeactivate()"
							 xmlns:loadingAndErrorMessage="customComponents.loadingAndErrorMessage.*">
	
	<customComponents:states>
		<s:State name="loading"/>
		<s:State name="complete"/>
		<s:State name="error"/>
	</customComponents:states>
	
	<fx:Script>
		<![CDATA[
			import com.facebook.graph.FacebookMobile;
			
			import mx.collections.ArrayCollection;
			
			import services.FBService;
			
			[Bindable]
			private var _dp:ArrayCollection=new ArrayCollection();
			
			private var _isLoadedOnce:Boolean = false;
			
			private function onViewActivate():void{
				
				if(_isLoadedOnce==false){					
					FacebookMobile.api("me/friendrequests",handleUserRequests);
				}
			}
			
			override protected function onViewDeactivate():void{
				super.onViewDeactivate();
				if(list && list.hasEventListener(MouseEvent.CLICK)){
					trace("removing el");
					list.removeEventListener(MouseEvent.CLICK,onClickList);
				}
			}
			
			private function handleUserRequests(success:Object,fail:Object):void
			{
				if(success){
					_isLoadedOnce = true;
					var response:Array = success as Array;
					for(var i:uint = 0;i < response.length;i++){
						var obj:Object = new Object();
						obj.label = response[i].from.name + " sent a friend request";
						obj.id = response[i].from.id;
						_dp.addItem(obj);
					}
					currentState = "complete";
				}else{
					currentState = "error";
				}
				
			}
			
			private function onClickList():void{
				var url:URLRequest = new URLRequest("http://m.facebook.com/friends.php");
				navigateToURL( url, '_blank' );
			}
			
		]]>
	</fx:Script>
	
	<!--loading,error state-->
	<s:VGroup width="100%"
			  height="100%"
			  includeIn="loading,error"
			  verticalCenter="0"
			  horizontalCenter="0"
			  verticalAlign="middle"
			  horizontalAlign="center">
		<loadingAndErrorMessage:LoadingAndErrorMessageComponent id="loadingMessage"
																message="Loading content..."
																includeIn="loading"/>
		<loadingAndErrorMessage:LoadingAndErrorMessageComponent id="errorMessage"
																message="Error loading content..."
																includeIn="error"/>
	</s:VGroup>
	
	<s:VGroup width="100%"
			  height="100%"
			  includeIn="complete"
			  contentBackgroundAlpha="0">
		<s:List id="list"
				width="100%"
				height="100%"
				dataProvider="{_dp}"
				alternatingItemColors="[#999999,#999999]"
				useVirtualLayout="false"
				click="onClickList()"
				itemRenderer="itemrenderers.FriendsRequestItemRenderer"/>
			
	</s:VGroup>

	
</customComponents:CustomView>
