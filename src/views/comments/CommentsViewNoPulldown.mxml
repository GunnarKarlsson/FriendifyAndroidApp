<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:itemrenderers="itemrenderers.*"
		viewActivate="onViewActivate()"
		viewDeactivate="onViewDeactivate()"
		creationComplete="onCreationComplete()"
		xmlns:customComponents="customComponents.*"
		destructionPolicy="never"
		title="Comments"
		xmlns:loadingAndErrorMessage="customComponents.loadingAndErrorMessage.*">

	<s:states>
		<s:State name="loading"/>
		<s:State name="complete"/>
		<s:State name="error"/>
	</s:states>

	<s:actionContent>
		<s:BusyIndicator id="bi"
						 symbolColor="white"
						 visible="false"
						 left="10"/>
		<s:Label id="likesCount"
				 styleName="actionsText"/>
		<s:Image id="likeIcon"
				 source="@Embed('assets/images/icons/metalLike001.png')"/>
		<s:Button label="like"
				  id="likeButton"
				  click="onClickLikeButton()"/>
	</s:actionContent>

	<fx:Script>
		<![CDATA[
			import VOs.NewsFeedVO;

			import com.facebook.graph.FacebookMobile;
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomDataEvent;
			import com.squidzoo.eventSystem.events.CustomEvent;

			import customComponents.callouts.PostCommentCallout;

			import itemrenderers.AlertItemRenderer;
			import itemrenderers.CommentItemRendererWithSpeechBubble;
			import itemrenderers.CommentsNewsFeedItemRenderer;
			import itemrenderers.LoadingItemRenderer;
			import itemrenderers.PhotoCommentsHeader;
			import itemrenderers.newsFeedItemRenderer.CommentsHeaderItemRendererWithSpeechBubbleLayout;
			import itemrenderers.newsFeedItemRenderer.NewsFeedItemRendererWithSpeechBubbleLayout;

			import mx.collections.ArrayCollection;
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;

			import org.igniterealtime.xiff.events.BookmarkChangedEvent;

			import services.FBService;

			import spark.components.supportClasses.ItemRenderer;
			import spark.events.PopUpEvent;

			private var _service:FBService=new FBService();
			private var _offset:int=40; //20 on each side
			[Bindable]
			private var _dataObject:Object;
			[Bindable]
			private var _comments:ArrayCollection=new ArrayCollection();
			[Bindable]
			private var _contentWidth:int=FlexGlobals.topLevelApplication.stage.stageWidth - _offset;
			private var _message:String;

			private var _hasHeader:Boolean=false;

			private var _idHash:Object=new Object();

			private var _firstIdHash:Boolean=false;

			private var _postCommentCallout:PostCommentCallout=new PostCommentCallout();

			private var _stageRef:Stage;
			
			private function onCreationComplete():void{
				_stageRef = FlexGlobals.topLevelApplication.stage;
				FlexGlobals.topLevelApplication.stage.addEventListener(KeyboardEvent.KEY_DOWN, onKeyDown);
				EventCentral.getInstance().addEventListener(CustomDataEvent.COMMENT_DELETED,onCommentDeleted);
			}
			
			private function onKeyDown(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.BACK)
				{
					event.preventDefault();
					FlexGlobals.topLevelApplication.stage.removeEventListener(KeyboardEvent.KEY_DOWN, onKeyDown);
					navigator.popView();
				} 
			}
			
			private function onViewActivate():void
			{
				currentState="loading";
				_dataObject=data;

				populateLikeCount();

				_service.addEventListener(FBService.COMMENT_POST_ERROR, onCommentPostError);
				_service.addEventListener(FBService.COMMENT_POST_SUCCESS, onCommentPostSuccess);
				getComments();
			}

			private function onViewDeactivate():void
			{
				if (_service.hasEventListener(FBService.GET_COMMENTS_ERROR))
				{
					_service.removeEventListener(FBService.GET_COMMENTS_ERROR, onGetCommentsError);
				}
				if (_service.hasEventListener(FBService.GET_COMMENTS_SUCCESS))
				{
					_service.removeEventListener(FBService.GET_COMMENTS_SUCCESS, onGetCommentsSuccess);
				}
				if (_service.hasEventListener(FBService.COMMENT_POST_ERROR))
				{
					_service.removeEventListener(FBService.COMMENT_POST_ERROR, onCommentPostError);
				}
				if (_service.hasEventListener(FBService.COMMENT_POST_SUCCESS))
				{
					_service.removeEventListener(FBService.COMMENT_POST_SUCCESS, onCommentPostSuccess);
				}
			}

			private function onCommentDeleted(event:CustomDataEvent):void{
				FlexGlobals.topLevelApplication.stage.focus = _stageRef;
				var deletedCommentId:String = event.data;
				for(var i:int = _comments.length - 1;i >= 0;i--){
					if(_comments[i].id == deletedCommentId){
						_comments.removeItemAt(i);
						list.invalidateDisplayList();
					}
				}
			}
			
			private function onClickLikeButton():void
			{
				bi.visible=true;
				likeButton.label="....."
				if (_dataObject.userLikesIt)
				{
					FacebookMobile.deleteObject('/' + _dataObject.id + '/likes', handlePostUnliked);
				}
				else
				{
					FacebookMobile.api('/' + _dataObject.id + '/likes', handlePostLiked, null, "POST");
				}
			}

			private function handlePostUnliked(response:Object, fail:Object):void
			{
				bi.visible=false;
				if (response)
				{
					_dataObject.likesCount--;
					_dataObject.userLikesIt=false;
					likeButton.label="like";
					populateLikeCount();
				}
			}

			private function handlePostLiked(response:Object, fail:Object):void
			{
				bi.visible=false;
				if (response)
				{
					(_dataObject.likesCount == 0) ? _dataObject.likesCount=1 : _dataObject.likesCount++;
					_dataObject.userLikesIt=true;
					likeButton.label="Unlike";
					populateLikeCount();
				}
			}

			private function populateLikeCount():void
			{
				trace("t1");
				likeButton.includeInLayout=false;
				likeButton.visible=false;

				if (_dataObject.hasOwnProperty("userLikesIt"))
				{
					trace("t2");
					likeButton.includeInLayout=true;
					likeButton.visible=true;
					if (_dataObject.userLikesIt == false)
					{
						likeButton.label='Like';
					}
					else
					{
						likeButton.label='UnLike';
					}

				}

				likesCount.text=_dataObject.likesCount == 0 ? "" : _dataObject.likesCount + ' likes  ';
				if (_dataObject.likesCount < 1 || _dataObject.likesCount == undefined)
				{
					trace("t3");
					likeIcon.includeInLayout=false;
					likeIcon.visible=false;
					likesCount.includeInLayout=false;
					likesCount.visible=false;
				}
			}


			private function getComments():void
			{
				_service.addEventListener(FBService.GET_COMMENTS_ERROR, onGetCommentsError);
				_service.addEventListener(FBService.GET_COMMENTS_SUCCESS, onGetCommentsSuccess);
				currentState="loading";
				_service.getComments(_dataObject.id);
			}

			private function onClickPostButton():void
			{
				_service.addEventListener(FBService.COMMENT_POST_ERROR, onCommentPostError);
				_service.addEventListener(FBService.COMMENT_POST_SUCCESS, onCommentPostSuccess);
				_service.submitComment(_dataObject.id, _message);
			}

			private function chooseItemRenderer(item:Object):ClassFactory
			{
				var ir:Class=CommentItemRendererWithSpeechBubble;

				switch (item.type)
				{
					case "PhotoVO":
						ir=PhotoCommentsHeader;
						break;
					case "loading":
						ir=LoadingItemRenderer;
						break;
					case "link":
						ir=CommentsHeaderItemRendererWithSpeechBubbleLayout;
						break;
					case "status":
						ir=CommentsHeaderItemRendererWithSpeechBubbleLayout;
						break;
					case "photo":
						ir=CommentsHeaderItemRendererWithSpeechBubbleLayout;
						break;
					case "video":
						ir=CommentsHeaderItemRendererWithSpeechBubbleLayout;
						break;
					case "alert":
						ir=AlertItemRenderer;
						break;

					default:
						break;
				}

				return new ClassFactory(ir);
			}

			private function onGetCommentsError(event:Event):void
			{
				_service.removeEventListener(FBService.GET_COMMENTS_ERROR, onGetCommentsError);
				_service.removeEventListener(FBService.GET_COMMENTS_SUCCESS, onGetCommentsSuccess);
				//list.setPostFeedReceivedState();
				currentState="error";
			}

			private function onGetCommentsSuccess(event:Event):void
			{
				_service.removeEventListener(FBService.GET_COMMENTS_ERROR, onGetCommentsError);
				_service.removeEventListener(FBService.GET_COMMENTS_SUCCESS, onGetCommentsSuccess);
				//after first load of comments, assign their ids to a hash table
				//and add all comments to dp
				if (_firstIdHash == false)
				{
					for (var i:uint=0; i < _service.comments.length; i++)
					{
						_idHash[_service.comments[i].id]=true;
						_comments.addItem(_service.comments[i]);
					}
					_firstIdHash=true;
				}

				//only copy comment to dp if comment id isn't in hash table
				for (var k:uint=0; k < _service.comments.length; k++)
				{
					if (_idHash.hasOwnProperty(_service.comments[k].id) == false)
					{
						_comments.addItem(_service.comments[k]);
						_idHash[_service.comments[k].id]=true;
					}
				}

				currentState="complete";

				if (_hasHeader == false)
				{
					_comments.addItemAt(_dataObject, 0);
					_hasHeader=true;
					
				}
				else
				{
				
				}

				
				for(var m:int = _comments.length - 1;m >= 0;m--){
					if(_comments[m].type == "alert"){
						_comments.removeItemAt(m);
					}
				}
				
				if (_comments.length < 2)
				{
					var vo:Object=new Object();
					vo.type="alert";
					vo.label="No comments yet";
					vo.icon="assets/images/icons/metalComment001.png";
					_comments.addItem(vo);
				}

			}

			private function onCommentPostError(event:Event):void
			{
				_service.removeEventListener(FBService.COMMENT_POST_ERROR, onCommentPostError);
				_service.removeEventListener(FBService.COMMENT_POST_SUCCESS, onCommentPostSuccess);
				trace("cv post error");
			}

			private function onCommentPostSuccess(event:Event):void
			{
				trace("cv post success");
				_service.removeEventListener(FBService.COMMENT_POST_ERROR, onCommentPostError);
				_service.removeEventListener(FBService.COMMENT_POST_SUCCESS, onCommentPostSuccess);
				getComments();
			}

			private function openCallout(event:MouseEvent, owner:UIComponent, value:String):void
			{
				_postCommentCallout.addEventListener('close', closeHandler);
				_postCommentCallout.setStyle('contentBackgroundAppearance', value);
				_postCommentCallout.open(owner);
			}

			private function closeHandler(event:PopUpEvent):void
			{
				_postCommentCallout.removeEventListener('close', closeHandler);
				if (event.data != null)
				{
					if (event.data.message != null && event.data.message != "")
					{
						_service.addEventListener(FBService.COMMENT_POST_ERROR, onCommentPostError);
						_service.addEventListener(FBService.COMMENT_POST_SUCCESS, onCommentPostSuccess);
						trace("id: "+_dataObject.id +" message: "+_message);
						_service.submitComment(_dataObject.id, event.data.message);
					}
				}
			}
		]]>
	</fx:Script>

	<!--loading,error state-->
	<s:VGroup width="100%"
			  height="100%"
			  includeIn="loading,error"
			  verticalCenter="0"
			  horizontalCenter="0"
			  verticalAlign="middle"
			  horizontalAlign="center">
		<loadingAndErrorMessage:LoadingAndErrorMessageComponent id="loadingMessage"
																message="Loading content..."
																includeIn="loading"/>
		<loadingAndErrorMessage:LoadingAndErrorMessageComponent id="errorMessage"
																message="Error loading content..."
																includeIn="error"/>
	</s:VGroup>

	<s:VGroup includeIn="complete"
			  width="100%"
			  height="100%"
			  gap="0">

		<s:List id="list"
				dataProvider="{_comments}"
				width="100%"
				height="100%"
				itemRendererFunction="chooseItemRenderer"
				contentBackgroundAlpha="0"
				horizontalScrollPolicy="off"/>

		<s:HGroup width="100%"
				  paddingBottom="5"
				  paddingLeft="5"
				  paddingRight="5"
				  paddingTop="5"
				  verticalAlign="middle">
			<s:Button id="postButton"
					  width="100%"
					  label="Comment"
					  click="openCallout(event, postButton, spark.components.ContentBackgroundAppearance.NONE)"/>
		</s:HGroup>
	</s:VGroup>

</s:View>
