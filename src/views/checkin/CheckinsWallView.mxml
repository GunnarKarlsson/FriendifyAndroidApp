<?xml version="1.0" encoding="utf-8"?>
<customComponents:CustomView xmlns:fx="http://ns.adobe.com/mxml/2009"
							 xmlns:s="library://ns.adobe.com/flex/spark"
							 xmlns:customComponents="customComponents.*"
							 title="Checkins"
							 viewActivate="onViewActivate()"
							 viewDeactivate="onViewDeactivate()"
							 currentState="loading"
							 xmlns:loadingAndErrorMessage="customComponents.loadingAndErrorMessage.*">

	<customComponents:states>
		<s:State name="loading"/>
		<s:State name="error"/>
		<s:State name="complete"/>
	</customComponents:states>

	<customComponents:actionContent>
		<s:Button icon="@Embed('assets/images/icons/metalCheckin001.png')"
				  click="navigator.pushView(CheckinPlaceSelectionView)"/>
	</customComponents:actionContent>

	<fx:Script>
		<![CDATA[
			import assets.GraphicAssetFactory;

			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomDataEvent;

			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;

			import services.FBService;

			import views.place.PlaceView;
			import views.place.PlaceWallView;

			private var service:FBService=new FBService();
			[Bindable]
			private var checkins:ArrayCollection=new ArrayCollection();

			private function onViewActivate():void
			{
				service.addEventListener(FBService.GET_CHECKINS_SUCCESS, onGetCheckinsSuccess);
				service.addEventListener(FBService.GET_CHECKINS_ERROR, onGetCheckinsErroe);
				service.getCheckins();
			}
			
			override protected function onViewDeactivate():void
			{
				super.onViewDeactivate();
				service.removeEventListener(FBService.GET_CHECKINS_SUCCESS, onGetCheckinsSuccess);
				service.removeEventListener(FBService.GET_CHECKINS_ERROR, onGetCheckinsErroe);
			}

			private function onGetCheckinsSuccess(event:Event):void
			{
				checkins=service.checkinItems;
				currentState="complete";
			}

			private function onGetCheckinsErroe(event:Event):void
			{
				currentState="error";
			}

			private function onClickCheckin():void
			{
				if (checkinList.selectedIndex > -1)
				{
					if (checkinList.selectedItem.place != undefined && checkinList.selectedItem.place.id != undefined)
					{
						trace("checkin wall disp");
						var vo:Object=new Object();
						vo.id=checkinList.selectedItem.place.id;
						EventCentral.getInstance().dispatchEvent(new CustomDataEvent(CustomDataEvent.LOCATION_SELECTED, null, vo));
					}
				}
			}
		]]>
	</fx:Script>


	<!--loading,error state-->
	<s:VGroup width="100%"
			  height="100%"
			  includeIn="loading,error"
			  verticalCenter="0"
			  horizontalCenter="0"
			  verticalAlign="middle"
			  horizontalAlign="center">
		<loadingAndErrorMessage:LoadingAndErrorMessageComponent id="loadingMessage"
																message="Loading content..."
																includeIn="loading"/>
		<loadingAndErrorMessage:LoadingAndErrorMessageComponent id="errorMessage"
																message="Error loading content..."
																includeIn="error"/>
	</s:VGroup>

	<s:VGroup width="100%"
			  height="100%"
			  includeIn="complete">
		<s:List id="checkinList"
				dataProvider="{checkins}"
				width="100%"
				height="100%"
				itemRenderer="itemrenderers.CheckinItemRenderer"
				useVirtualLayout="false"
				click="onClickCheckin()"
				contentBackgroundAlpha="0"
				alternatingItemColors="{GraphicAssetFactory.getAlteratingColorsForList()}">
			<s:layout>
				<s:VerticalLayout/>
			</s:layout>
		</s:List>
	</s:VGroup>

</customComponents:CustomView>
